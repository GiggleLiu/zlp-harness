# Zulip bridge for the <<TOPIC>>.harness — connects to <<ZULIP_STREAM>>
# on <<ZULIP_SITE>>. Archive lands under .zulip/ in the repo and is
# gitignored locally so it never round-trips to GitHub.
#
# Per-machine override: set ZULIP_WORKSPACE to wherever your <<WORKSPACE_LABEL>>
# workspace lives, e.g. in your shell rc:
#   export ZULIP_WORKSPACE=$HOME/zulip-workspaces/<<WORKSPACE_LABEL>>
# The workspace dir must contain a `zuliprc` (Zulip API key file).

ZULIP_WORKSPACE         ?=
ZULIP_STREAM            := <<ZULIP_STREAM>>
ZULIP_SITE              := <<ZULIP_SITE>>
ZULIP_WORKSPACE_DEFAULT := $(HOME)/zulip-workspaces/<<WORKSPACE_LABEL>>
ZULIP_LOCAL             := $(CURDIR)/.zulip

# Per-target guard — fires only when a target needs ZULIP_WORKSPACE.
# Crucially, this lets `make zulip-config` run on a fresh clone before
# the env var is set (the onboard skill calls it for site/path/stream).
require-workspace = $(if $(strip $(ZULIP_WORKSPACE)),,$(error ZULIP_WORKSPACE is not set. Export it (e.g. `export ZULIP_WORKSPACE=$$HOME/zulip-workspaces/<<WORKSPACE_LABEL>>`) or pass it on the command line.))

export ZULIP_CONFIG_FILE := $(ZULIP_WORKSPACE)/zuliprc
export ZLP_ARCHIVE_ROOT  := $(ZULIP_LOCAL)
export ZLP_RUN_ROOT      := $(ZULIP_LOCAL)/.run

ZLP := zlp

.PHONY: zulip-whoami zulip-pull zulip-send zulip-topics zulip-messages zulip-config

# Stable KEY=VALUE contract for the zlp-harness plugin's zlp-onboard skill.
# Adding new keys is additive; older skill versions ignore unknown lines.
zulip-config:
	@echo "ZULIP_SITE=$(ZULIP_SITE)"
	@echo "ZULIP_STREAM=$(ZULIP_STREAM)"
	@echo "ZULIP_WORKSPACE_DEFAULT=$(ZULIP_WORKSPACE_DEFAULT)"

zulip-whoami:
	$(require-workspace) $(ZLP) whoami

zulip-topics:
	$(require-workspace) $(ZLP) topics --stream "$(ZULIP_STREAM)"

zulip-messages:
	$(require-workspace) $(ZLP) messages --stream "$(ZULIP_STREAM)" $(if $(TOPIC),--topic "$(TOPIC)") --limit "$(or $(LIMIT),50)" --format "$(or $(FORMAT),md)"

zulip-pull:
	$(require-workspace) $(ZLP) pull --stream "$(ZULIP_STREAM)" $(if $(TOPIC),--topic "$(TOPIC)") $(if $(IMPORT_HISTORY),--import-history)

zulip-send:
	@test -n "$(TOPIC)" || { echo "TOPIC=... required"; exit 1; }
	@test -n "$(MSG)$(MSG_FILE)" || { echo "MSG=... or MSG_FILE=... required"; exit 1; }
	$(require-workspace) $(ZLP) send --stream "$(ZULIP_STREAM)" --topic "$(TOPIC)" \
	  $(if $(MSG),--msg "$(MSG)") $(if $(MSG_FILE),--msg-file "$(MSG_FILE)")
